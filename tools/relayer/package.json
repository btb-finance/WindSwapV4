{
  "name": "@windswap/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain relayer for Wind Swap v4: watches EVM vault deposits and broadcasts MPC-signed withdrawals",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts run",
    "serve": "tsx src/cli.ts serve",
    "once": "tsx src/cli.ts once",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@near-js/accounts": "^2.5.1",
    "@near-js/crypto": "^2.5.1",
    "@near-js/providers": "^2.5.1",
    "@near-js/signers": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
